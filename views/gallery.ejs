<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gallery | RIIZE briize</title>
  <link rel="stylesheet" href="/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <!-- ดึง Navbar จากไฟล์กลาง -->
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="text-center mb-5">
      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2">PHOTOS</span>
      <h1 class="display-5 fw-bold">ภาพบรรยากาศและโปรโมต</h1>
      <p class="text-body-secondary">รวมภาพ Concept Photo สวยๆ ของเมมเบอร์</p>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <div class="card gallery-item border-0 shadow-sm overflow-hidden">
          <img src="/assets/gallery-1.jpg" class="card-img-top" alt="RIIZING Concept">
          <div class="card-body p-3">
            <h2 class="h6 mb-1">RIIZING Concept</h2>
            <p class="small text-body-secondary mb-0">คอนเซปต์: <strong>Boom Boom Bass</strong></p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="card gallery-item border-0 shadow-sm overflow-hidden">
          <img src="/assets/gallery-2.jpeg" class="card-img-top" alt="Debut Showcase">
          <div class="card-body p-3">
            <h2 class="h6 mb-1">Debut Showcase</h2>
            <p class="small text-body-secondary mb-0">สถานที่: <strong>Seoul</strong></p>
          </div>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <div class="card gallery-item border-0 shadow-sm overflow-hidden">
          <img src="/assets/gallery-3.webp" class="card-img-top" alt="Love 119 Special">
          <div class="card-body p-3">
            <h2 class="h6 mb-1">Love 119 Winter</h2>
            <p class="small text-body-secondary mb-0">ธีม: <span class="badge bg-info-subtle text-info-emphasis">Snowy Film</span></p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="py-4 bg-white border-top">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
      <small class="text-body-secondary">170 นันท์นภัส สุภัคดำรงกุล</small>
      <small class="badge rounded-pill text-bg-light border">SM Entertainment</small>
    </div>
  </footer>

  <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>