<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join BRIIZE | RIIZE briize</title>
  <link rel="stylesheet" href="/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <!-- ดึง Navbar จากไฟล์กลาง -->
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="text-center mb-5">
      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2">MEMBERSHIP</span>
      <h1 class="display-5 fw-bold">สมัครแฟนคลับ BRIIZE</h1>
      <p class="text-body-secondary">สมัครสมาชิกเพื่อเข้าชมข้อมูลวงและกิจกรรมทั้งหมด</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-7">
        <div class="card shadow-sm border-0 p-4 p-md-5">

          <!-- กล่องแสดง Error หากสมัครไม่ผ่าน (ส่งมาจาก Server) -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <!-- ส่งข้อมูลแบบ POST ไปที่ /register -->
          <form action="/register" method="POST" id="registerForm">
            <div class="mb-3">
              <label for="nameInput" class="form-label">ชื่อ-นามสกุล <strong>*</strong></label>
              <input type="text" class="form-control" id="nameInput" name="fullname" required>
            </div>
            <div class="mb-3">
              <label for="emailInput" class="form-label">อีเมลติดต่อ (ใช้เข้าสู่ระบบ) <strong>*</strong></label>
              <input type="email" class="form-control" id="emailInput" name="email" required>
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="passwordInput" class="form-label">รหัสผ่าน (ขั้นต่ำ 6 ตัว) <strong>*</strong></label>
                <input type="password" class="form-control" id="passwordInput" name="password" minlength="6" required>
              </div>
              <div class="col-md-6 mb-3">
                <label for="confirmPasswordInput" class="form-label">ยืนยันรหัสผ่าน <strong>*</strong></label>
                <input type="password" class="form-control" id="confirmPasswordInput" name="confirmPassword" minlength="6" required>
              </div>
            </div>
            <div class="mb-3">
              <label for="biasSelect" class="form-label">เลือกเมนที่คุณชอบ <span>(Bias)</span></label>
              <select class="form-select" id="biasSelect" name="bias">
                <option value="wonbin">Wonbin (วอนบิน)</option>
                <option value="shotaro">Shotaro (โชทาโร่)</option>
                <option value="sungchan">Sungchan (ซองชาน)</option>
                <option value="eunseok">Eunseok (อึนซอก)</option>
                <option value="sohee">Sohee (โซฮี)</option>
                <option value="anton">Anton (แอนตัน)</option>
              </select>
            </div>
            <div class="mb-4">
              <label for="msgInput" class="form-label">ข้อความให้กำลังใจ RIIZE</label>
              <textarea class="form-control" id="msgInput" name="message" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">ยืนยันการสมัคร</button>
          </form>

          <div class="text-center mt-3">
            <small class="text-body-secondary">เป็นสมาชิก BRIIZE อยู่แล้ว? <a href="/login">เข้าสู่ระบบที่นี่</a></small>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="py-4 bg-white border-top">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
      <small class="text-body-secondary">170 นันท์นภัส สุภัคดำรงกุล</small>
      <small class="badge rounded-pill text-bg-light border">SM Entertainment</small>
    </div>
  </footer>

  <script src="/vendor/bootstrap.bundle.min.js"></script>
  <!-- ตรวจสอบรหัสผ่านตรงกันฝั่ง Client ก่อนส่ง -->
  <script>
    document.getElementById('registerForm').addEventListener('submit', function(e) {
      const pass = document.getElementById('passwordInput').value;
      const confirmPass = document.getElementById('confirmPasswordInput').value;
      if (pass !== confirmPass) {
        e.preventDefault();
        alert('รหัสผ่านและยืนยันรหัสผ่านไม่ตรงกัน กรุณากรอกใหม่ครับ');
      }
    });
  </script>
</body>
</html>