<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Discography | RIIZE briize</title>
  <link rel="stylesheet" href="/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <!-- ดึง Navbar จากไฟล์กลาง -->
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="text-center mb-5">
      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2">DISCOGRAPHY</span>
      <h1 class="display-5 fw-bold">ผลงานเพลงทั้งหมด</h1>
      <p class="text-body-secondary">รวมซิงเกิลและมินิอัลบั้มที่เปิดตัวของ RIIZE</p>
    </div>

    <div class="row g-4">
      <!-- Card 1 -->
      <div class="col-lg-6">
        <div class="card discography-card h-100 shadow-sm border-0">
          <div class="row g-0 align-items-center">
            <div class="col-md-5">
              <img src="/assets/album-riizing.jpeg" class="img-fluid rounded-start w-100 h-100 object-fit-cover" alt="RIIZING">
            </div>
            <div class="col-md-7">
              <div class="card-body p-4">
                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle mb-2">The 1st Mini Album</span>
                <h2 class="card-title h4">RIIZING</h2>
                <p class="text-body-secondary small mb-2">วางจำหน่าย: <strong>17 มิถุนายน 2024</strong></p>
                <p class="small mb-3">เพลงไตเติล: <span class="badge bg-warning text-dark">Boom Boom Bass</span></p>
                <ol class="list-group list-group-numbered list-group-flush small">
                  <li class="list-group-item bg-transparent px-0 py-1">Boom Boom Bass</li>
                  <li class="list-group-item bg-transparent px-0 py-1">Siren</li>
                  <li class="list-group-item bg-transparent px-0 py-1">Impossible</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="col-lg-6">
        <div class="card discography-card h-100 shadow-sm border-0">
          <div class="row g-0 align-items-center">
            <div class="col-md-5">
              <img src="/assets/album-guitar.png" class="img-fluid rounded-start w-100 h-100 object-fit-cover" alt="Get A Guitar">
            </div>
            <div class="col-md-7">
              <div class="card-body p-4">
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle mb-2">Debut Single Album</span>
                <h2 class="card-title h4">Get A Guitar</h2>
                <p class="text-body-secondary small mb-2">วางจำหน่าย: <strong>4 กันยายน 2023</strong></p>
                <p class="small mb-3">เพลงไตเติล: <span class="badge bg-warning text-dark">Get A Guitar</span></p>
                <ol class="list-group list-group-numbered list-group-flush small">
                  <li class="list-group-item bg-transparent px-0 py-1">Get A Guitar</li>
                  <li class="list-group-item bg-transparent px-0 py-1">Memories</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="py-4 bg-white border-top">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
      <small class="text-body-secondary">170 นันท์นภัส สุภัคดำรงกุล</small>
      <small class="badge rounded-pill text-bg-light border">SM Entertainment</small>
    </div>
  </footer>

  <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>